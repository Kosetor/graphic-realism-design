{
  "$schema": "https://github.com/Kosetor/graphic-realism-design/tokens/tokens.schema.json",
  "name": "graphic-realism",
  "version": "1.0.0",
  "color": {
    "bg": {
      "void": "#0B0C0E",
      "base": "#12141A",
      "panel": "#1A1D24",
      "elevated": "#242832",
      "white": "#E8EAEF",
      "frost": "#F4F5F7"
    },
    "ink": {
      "primary": "#0B0C0E",
      "onDark": "#F4F5F7",
      "muted": "#8B919C",
      "faint": "#5A606C"
    },
    "line": {
      "default": "#2E3440",
      "strong": "#4A5160",
      "onLight": "#C5C9D2"
    },
    "accent": {
      "signal": "#FF3B4A",
      "volt": "#C8F542",
      "cyan": "#3DE0FF",
      "amber": "#FFB020",
      "violet": "#A78BFA"
    },
    "hazard": {
      "a": "#0B0C0E",
      "b": "#F5C400",
      "w": "#F4F5F7"
    },
    "semantic": {
      "ok": "#3DDC97",
      "warn": "#FFB020",
      "err": "#FF3B4A",
      "info": "#3DE0FF"
    }
  },
  "typography": {
    "fontFamily": {
      "ui": "Inter, IBM Plex Sans, Helvetica Neue, system-ui, sans-serif",
      "display": "Space Grotesk, Chakra Petch, DIN Condensed, sans-serif",
      "mono": "IBM Plex Mono, JetBrains Mono, Roboto Mono, ui-monospace, monospace"
    },
    "fontSize": {
      "xs": 11,
      "sm": 12,
      "md": 14,
      "lg": 16,
      "xl": 20,
      "2xl": 28,
      "3xl": 40
    },
    "letterSpacing": {
      "display": "0.04em",
      "label": "0.08em"
    }
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 24,
    "6": 32,
    "7": 48
  },
  "radius": {
    "none": 0,
    "sm": 2,
    "md": 4,
    "lg": 8,
    "pill": 999
  },
  "border": {
    "default": 1,
    "strong": 2
  },
  "icon": {
    "size": 24,
    "stroke": 1.75,
    "gridSafe": 2
  },
  "motion": {
    "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "fast": 120,
    "ui": 180,
    "panel": 280
  }
}
